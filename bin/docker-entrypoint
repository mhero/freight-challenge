#!/bin/bash -e

# Wait for PostgreSQL, prepare the schema (idempotent), then hand over.
# Everything here logs to stderr so stdout stays clean for the CLI.

if [ -n "$DATABASE_URL" ]; then
  tries=0
  until pg_isready -q -d "$DATABASE_URL"; do
    tries=$((tries + 1))
    if [ "$tries" -ge 60 ]; then
      echo "PostgreSQL is not reachable at DATABASE_URL" >&2
      exit 1
    fi
    echo "Waiting for PostgreSQL..." >&2
    sleep 1
  done
fi

./bin/rails db:prepare >&2

# Cold start: import the bundled feed (FEED_PATH to override) before any command runs,
# so a search never sees an empty database. Skipped for tests.
if [ "${SEED_ON_BOOT:-true}" = "true" ] && [ "${RAILS_ENV:-}" != "test" ]; then
  ./bin/rails freight:seed >&2
fi

exec "${@}"
